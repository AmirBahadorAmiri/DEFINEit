<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/activity_conversation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/conversation"
        android:textColor="@color/text_color"
        android:textSize="@dimen/HeaderText"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activity_conversation_settings_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/activity_conversation_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/activity_conversation_title"
        app:srcCompat="@drawable/ic_settings" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/activity_conversation_from_btn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="8dp"
        android:textColor="@color/text_color"
        android:textSize="@dimen/LargeText"
        android:textStyle="normal"
        app:backgroundTint="@color/on_page_background"
        app:cornerRadius="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/activity_conversation_reverse_btn"
        app:layout_constraintTop_toBottomOf="@id/activity_conversation_title"
        app:rippleColor="@color/page_background"
        tools:text="Persian" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activity_conversation_reverse_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        app:layout_constraintLeft_toRightOf="@id/activity_conversation_from_btn"
        app:layout_constraintRight_toLeftOf="@id/activity_conversation_to_btn"
        app:layout_constraintTop_toBottomOf="@id/activity_conversation_title"
        app:srcCompat="@drawable/ic_reverse" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/activity_conversation_to_btn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="16dp"
        android:textColor="@color/text_color"
        android:textSize="@dimen/LargeText"
        android:textStyle="normal"
        app:backgroundTint="@color/on_page_background"
        app:cornerRadius="32dp"
        app:layout_constraintLeft_toRightOf="@id/activity_conversation_reverse_btn"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_conversation_title"
        app:rippleColor="@color/page_background"
        tools:text="English" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/activity_conversation_edit_view"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:cardBackgroundColor="@color/on_page_background"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeColor="@android:color/transparent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_conversation_from_btn">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/activity_conversation_send_from"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:srcCompat="@drawable/ic_send_invert" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/activity_conversation_mic_from"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:srcCompat="@drawable/ic_mic" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/activity_conversation_edittext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="@string/write_your_text"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/text_color"
                android:textColorHint="@color/hint_text_color"
                android:textSize="@dimen/LargeText"
                android:textStyle="normal" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/activity_conversation_mic_to"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:srcCompat="@drawable/ic_mic" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/activity_conversation_send_to"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:srcCompat="@drawable/ic_send" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activity_conversation_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_conversation_edit_view" />

</androidx.constraintlayout.widget.ConstraintLayout>
